{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "target": "esnext",
    "checkJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
  },
  "include": [
    "src/components/**/*.js",
    "src/components/layout/TopBar.jsx",
    "src/pages/**/*.jsx",
    "src/auth/**/*.{js,jsx}",
    "src/lib/supabase.js",
    "src/vite-env.d.ts",
    "src/Layout.jsx"
  ],
  "exclude": ["node_modules", "dist", "src/vite-plugins", "src/components/ui", "src/api"]
} 